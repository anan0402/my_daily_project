VITE_API_LOCAL_BASE_URL='http://localhost:8017'

# Production: đi qua rewrite proxy của Vercel (xem vercel.json) để cookie là
# first-party -> không bị tab ẩn danh / Safari chặn. KHÔNG trỏ thẳng sang Render.
VITE_API_PRODUCTION_BASE_URL='/api'

# Socket.IO phải nối THẲNG tới Render vì Vercel rewrite không proxy WebSocket.
VITE_SOCKET_PRODUCTION_URL='https://YOUR-SERVICE.onrender.com'

# Google Client ID for OAuth
VITE_GOOGLE_CLIENT_ID=''
